<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EduZone API Status</title>
    <link
      href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css"
      rel="stylesheet"
    />
    <style>
      .status-badge {
        animation: pulse 2s infinite;
      }
      @keyframes pulse {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.7;
        }
      }
    </style>
  </head>
  <body
    class="bg-linear-to-br from-blue-50 to-indigo-100 text-gray-800 font-sans"
  >
    <div class="min-h-screen flex items-center justify-center p-4">
      <div
        class="bg-white shadow-2xl rounded-3xl p-10 max-w-2xl w-full space-y-8"
      >
        <!-- Header -->
        <div class="text-center space-y-2">
          <h1 class="text-4xl font-bold text-blue-600">🚀 EduZone API</h1>
          <div class="flex items-center justify-center gap-2">
            <span
              class="status-badge inline-block w-3 h-3 bg-green-500 rounded-full"
            ></span>
            <p class="text-lg font-semibold text-green-600">Operational</p>
          </div>
        </div>

        <!-- Status Message -->
        <div class="bg-green-50 border-l-4 border-green-500 p-4 rounded">
          <p class="text-green-700">✅ API is up and running smoothly!</p>
        </div>

        <!-- Server Information -->
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-blue-50 p-4 rounded-lg">
            <p class="text-sm text-gray-600">Greeting</p>
            <p class="font-semibold text-blue-600"><%= data.greeting %></p>
          </div>
          <div class="bg-indigo-50 p-4 rounded-lg">
            <p class="text-sm text-gray-600">Environment</p>
            <p class="font-semibold text-indigo-600"><%= data.environment %></p>
          </div>
          <div class="bg-purple-50 p-4 rounded-lg">
            <p class="text-sm text-gray-600">Server Time</p>
            <p class="font-semibold text-purple-600"><%= data.serverTime %></p>
          </div>
          <div class="bg-pink-50 p-4 rounded-lg">
            <p class="text-sm text-gray-600">Version</p>
            <p class="font-semibold text-pink-600"><%= data.version %></p>
          </div>
        </div>

        <!-- Uptime -->
        <div
          class="bg-linear-to-r from-green-50 to-emerald-50 p-6 rounded-lg border border-green-200"
        >
          <p class="text-sm text-gray-600 mb-1">⏱️ Server Uptime</p>
          <p class="text-3xl font-bold text-green-600">
            <%= uptime.toFixed(2) %>
          </p>
          <p class="text-xs text-gray-500 mt-1">seconds</p>
        </div>

        <!-- Actions -->
        <div class="flex gap-4 pt-4">
          <a
            href="<%= documentation %>"
            target="_blank"
            class="flex-1 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition duration-200 shadow-lg font-semibold text-center"
          >
            📖 View Documentation
          </a>
          <a
            href="/health"
            class="flex-1 px-6 py-3 bg-gray-200 hover:bg-gray-300 text-gray-800 rounded-lg transition duration-200 shadow font-semibold text-center"
          >
            🔍 Health Check
          </a>
        </div>

        <!-- Footer -->
        <div class="text-center text-sm text-gray-500 pt-4 border-t">
          <p>EduZone © 2024 • API v<%= data.version %></p>
        </div>
      </div>
    </div>
  </body>
</html>
